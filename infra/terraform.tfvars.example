# Copie para terraform.tfvars (arquivo ignorado pelo git) e ajuste se precisar.
# NÃO coloque senhas aqui: a senha do banco é gerada pelo Terraform (random_password).
aws_region   = "us-east-1"
project_name = "togglemaster"

# A role do EKS/nodes é criada pelo Terraform (infra/iam.tf).

# Ajuste se a sua conta não aceitar t3.medium:
# node_instance_types = ["c7i-flex.large"]
